# Database (MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>

# NextAuth
NEXTAUTH_SECRET=your_super_secret_key_here
NEXTAUTH_URL=http://localhost:3000

# Cloudflare R2 (Object Storage)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_FOLDER_PREFIX=helpdesk

# External APIs
GOOGLE_API_KEY=your_google_gemini_api_key
SCRAPE_DO_TOKEN=your_scrape_do_token

# Inngest Background Jobs
INNGEST_DEV=1

# Email SMTP Settings (For Magic Links/Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS="your_app_password"

# Server Port
PORT=3000

# Public URLs (Exposed to Browser)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WIDGET_SCRIPT_URL=https://cdn.jsdelivr.net/gh/yourusername/cdn/widget.js
